# Copiar para backend/.env e preencher. Gerar o segredo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
NUM_CTX=4096
NUM_PREDICT=500
# Limite de resposta (tokens) só para resumos; tem de caber em NUM_CTX com o contexto
SUMMARY_NUM_PREDICT=1000
# Contexto das ferramentas de casos práticos (resposta-modelo e resolver caso)
TOOLS_NUM_CTX=8192
LLM_SEED=0
TOP_K=4
SCORE_THRESHOLD=0.50
HISTORY_TURNS=3
CHAT_RETENTION_DAYS=60
SHARE_DEFAULT_MINUTES=120
# Dispositivos novos que entram pelo link ficam pendentes até o administrador os aprovar (0 desliga).
DEVICE_APPROVAL=1
# Caminho do cloudflared (Quick Tunnel), se não estiver no PATH.
CLOUDFLARED_BIN=cloudflared
# Perfil que pode gerir a partilha (e que vê o ecrã de entrada "Decrypter").
ADMIN_PROFILE=admin
REMOTE_SESSION_MAX_MINUTES=120
LOCAL_SESSION_HOURS=24
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
MAX_FILE_MB=50
MAX_FILES_PER_CONVERSATION=5
MAX_FILES_PER_LIBRARY=50
MAX_QUERY_CHARS=2000
INFERENCE_TIMEOUT_SECONDS=120
EMBEDDINGS_BACKEND=bge-m3
EMBEDDINGS_DEVICE=cpu
# pymupdf (omissão) ou docling (pip install docling; mais lento, às vezes lê melhor tabelas)
PDF_PARSER=pymupdf
INCLUDE_SPEAKER_NOTES=false
